# Partie B : Excel, SAS et export

## B1

```{r B1}
# a. Liste des feuilles du classeur Excel
feuilles_pluie <- excel_sheets("data/pluie_mensuelle.xlsx")
feuilles_pluie

# b. Importation des deux feuilles (en sautant les 3 lignes d'en-tête) et empilement avec annee numérique
pluie_2024 <- read_excel(
  "data/pluie_mensuelle.xlsx",
  sheet = "2024",
  skip = 3,
  na = c("", "NA", "-", "nd")
) %>%
  mutate(annee = 2024)

pluie_2025 <- read_excel(
  "data/pluie_mensuelle.xlsx",
  sheet = "2025",
  skip = 3,
  na = c("", "NA", "-", "nd")
) %>%
  mutate(annee = 2025)

# Empilement dans un seul tibble
pluie <- bind_rows(pluie_2024, pluie_2025)

# c. Calcul du cumul annuel de chaque station pour chaque année
col_station <- names(pluie)[1]
mois_cols <- setdiff(names(pluie), c(col_station, "annee"))

cumul_annuel_pluie <- pluie %>%
  mutate(cumul_annuel = rowSums(across(all_of(mois_cols)), na.rm = TRUE)) %>%
  select(all_of(col_station), annee, cumul_annuel) %>%
  pivot_wider(names_from = annee, values_from = cumul_annuel, names_prefix = "Annee_")

cumul_annuel_pluie
```

- **a.** Le classeur contient les feuilles **`r paste(feuilles_pluie, collapse = " et ")`**. À l'ouverture, le tableau de données commence à la **4e ligne** (il faut donc utiliser `skip = 3`).
- **b.** Les deux feuilles ont été importées et empilées dans le tibble `pluie` (**`r nrow(pluie)` lignes** au total) avec une colonne `annee` de type **`r class(pluie$annee)`**.
- **c.** Le tableau `cumul_annuel_pluie` présente le total des précipitations (en mm) enregistré par chaque station en 2024 et en 2025.

## B2

```{r B2}
library(haven)

# a. Importation du fichier SAS
pays <- read_sas("data/paysniv3.sas7bdat")

dim(pays)
# Variables contenant au moins une valeur manquante
vars_na <- names(which(colSums(is.na(pays)) > 0))
vars_na

# b. Transformation de CONTI en facteur nommé
pays <- pays %>%
  mutate(
    CONTI = factor(
      CONTI,
      levels = 1:5,
      labels = c("Afrique", "Asie", "Amériques", "Europe", "Océanie")
    )
  )

# c. Statistiques par continent triées par espérance de vie croissante
stats_continents <- pays %>%
  group_by(CONTI) %>%
  summarise(
    nb_pays = n(),
    esperance_vie_moy = round(mean(ESPER, na.rm = TRUE), 2),
    fecondite_moy = round(mean(FERTI, na.rm = TRUE), 2),
    pnb_median = median(PNB, na.rm = TRUE)
  ) %>%
  arrange(esperance_vie_moy)

stats_continents

# d. Les 5 pays où l'espérance de vie est la plus basse
top5_esperance_basse <- pays %>%
  filter(!is.na(ESPER)) %>%
  slice_min(ESPER, n = 5) %>%
  select(NOM, CONTI, ESPER, FERTI, PNB)

top5_esperance_basse
```

- **a.** Le jeu de données `pays` compte **`r nrow(pays)` pays** (lignes) et **`r ncol(pays)` variables** (colonnes). Les variables présentant des valeurs manquantes sont : **`r paste(vars_na, collapse = ", ")`**.
- **b.** La variable `CONTI` a été convertie en facteur (`is.factor(pays$CONTI)` vaut **`r is.factor(pays$CONTI)`**).
- **c.** Le tableau `stats_continents` résume les indicateurs démographiques et économiques par continent, classés par espérance de vie moyenne croissante.
- **d.** Les 5 pays ayant l'espérance de vie la plus faible sont : **`r paste(top5_esperance_basse$NOM, collapse = ", ")`**.

## B3

```{r B3}
library(writexl)

# Création du dossier sorties/ s'il n'existe pas encore
if (!dir.exists("sorties")) {
  dir.create("sorties")
}

# a. Export de bilan_meteo en CSV "à la française" (séparateur ; et virgule décimale)
write.csv2(bilan_meteo, "sorties/bilan_meteo.csv", row.names = FALSE, fileEncoding = "UTF-8")

# Relecture pour comparaison
bilan_relu <- read.csv2("sorties/bilan_meteo.csv", fileEncoding = "UTF-8")
all.equal(as.data.frame(bilan_meteo), bilan_relu)

# b. Export de pluie et bilan_meteo dans un seul fichier Excel (une feuille chacun)
write_xlsx(
  list(
    Pluie_mensuelle = pluie,
    Bilan_meteo = bilan_meteo
  ),
  path = "sorties/synthese_tp5.xlsx"
)

# c. Sauvegarde de pays au format .rds et vérification de la classe du facteur
saveRDS(pays, "sorties/pays.rds")
pays_relu <- readRDS("sorties/pays.rds")

is.factor(pays_relu$CONTI)
levels(pays_relu$CONTI)
```

- **a.** Après relecture avec `read.csv2()`, on retrouve exactement les mêmes valeurs et dimensions que `bilan_meteo` (à la différence près que `read.csv2()` renvoie un `data.frame` classique au lieu d'un `tibble`).
- **b.** Le classeur `sorties/synthese_tp5.xlsx` a été généré avec deux onglets distincts (`Pluie_mensuelle` et `Bilan_meteo`).
- **c.** Après sauvegarde et relecture au format `.rds`, la colonne `CONTI` conserve bien sa classe **`r class(pays_relu$CONTI)`** ainsi que l'ordre de ses niveaux (`r paste(levels(pays_relu$CONTI), collapse = ", ")`). Si l'on avait exporté en **CSV**, cette métadonnée aurait été perdue : la colonne aurait été relue comme un simple vecteur texte (`character`) ou entier, sans niveaux prédéfinis.


