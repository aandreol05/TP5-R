# Partie C : Ranger les données (tidy data)

## C1

```{r C1}
# Récupération dynamique du nom de la 1re colonne (identifiant de la station)
col_station <- names(pluie)[1]
mois_cols <- setdiff(names(pluie), c(col_station, "annee"))

# a. Passage au format long (une ligne par station, année et mois)
pluie_long <- pluie %>%
  pivot_longer(
    cols = all_of(mois_cols),
    names_to = "mois",
    values_to = "mm"
  ) %>%
  # b. Conversion de mois en facteur respectant l'ordre chronologique des colonnes
  mutate(mois = factor(mois, levels = mois_cols))

head(pluie_long)
levels(pluie_long$mois)

# c. Mois le plus pluvieux de chaque station en 2025
mois_max_2025 <- pluie_long %>%
  filter(annee == 2025) %>%
  group_by(across(all_of(col_station))) %>%
  slice_max(mm, n = 1, with_ties = FALSE) %>%
  select(all_of(col_station), mois, mm)

mois_max_2025

# d. Comparaison 2024 vs 2025 (format large par année et calcul de la différence)
diff_pluie <- pluie_long %>%
  pivot_wider(
    names_from = annee,
    values_from = mm,
    names_prefix = "Annee_"
  ) %>%
  mutate(difference = Annee_2025 - Annee_2024)

# Station et mois ayant connu la plus forte hausse
plus_forte_hausse <- diff_pluie %>%
  slice_max(difference, n = 1, with_ties = FALSE)

plus_forte_hausse
```

- **a & b.** Le tibble `pluie_long` contient **`r nrow(pluie_long)` lignes** et la colonne `mois` est bien un facteur ordonné selon le calendrier (`r paste(levels(pluie_long$mois), collapse = ", ")`).
- **c.** Le tableau `mois_max_2025` indique le mois le plus pluvieux enregistré en 2025 pour chacune des quatre stations.
- **d.** La plus forte hausse de précipitations entre 2024 et 2025 a été observée à **`r plus_forte_hausse[[1]][1]`** au mois de **`r plus_forte_hausse$mois[1]`**, avec une augmentation de **`r round(plus_forte_hausse$difference[1], 1)` mm** (`r round(plus_forte_hausse$Annee_2024[1], 1)` mm en 2024 contre `r round(plus_forte_hausse$Annee_2025[1], 1)` mm en 2025).